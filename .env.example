# Database connection string
# Default SQLite fallback (runs locally without Docker):
DATABASE_URL=sqlite:///./faulttrace.db

# Optional PostgreSQL connection (when running with Docker Compose):
# DATABASE_URL=postgresql://faulttrace_user:faulttrace_password@localhost:5432/faulttrace_db

# Weather Configuration
ENABLE_LIVE_WEATHER=false
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Synthetic Reference Coordinates (Bengaluru Hebbal Area)
DEFAULT_LATITUDE=13.0358
DEFAULT_LONGITUDE=77.5970
